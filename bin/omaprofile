#!/usr/bin/python3
"""Launcher: run the omaprofile package from this checkout."""
import os
import sys

# This checkout may be the shell plugin folder itself (omarchy plugin add);
# __pycache__ writes there would wake the shell's plugin watcher.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from omaprofile.cli import main  # noqa: E402

sys.exit(main())
